{
  "view": {
    "type": "view.list",
    "items": [
      {
        "type": "field.image-annotation",
        "image": {
          "type": "data.input",
          "path": "image"
        },
        "data": {
          "type": "data.internal",
          "path": "display_boxes",
          "default": {
            "type": "data.input",
            "path": "boxes"
          }
        },
        "disabled": true,
        "fullHeight": true,
        "shapes": {
          "rectangle": true
        }
      },
      {
        "type": "field.radio-group",
        "label": "Как размечен весь кадр?",
        "data": {
          "type": "data.output",
          "path": "verdict"
        },
        "options": [
          {
            "value": "accept",
            "label": "Верно — все бабочки обведены или их действительно нет"
          },
          {
            "value": "missing",
            "label": "Пропущена бабочка"
          },
          {
            "value": "extra",
            "label": "Лишняя рамка или один объект обведён дважды"
          },
          {
            "value": "boundary",
            "label": "Неточная рамка — срезает видимую часть или захватывает много фона"
          },
          {
            "value": "uncertain",
            "label": "Нужен разбор — объект невозможно уверенно определить"
          },
          {
            "value": "load_error",
            "label": "Фотография не загрузилась"
          }
        ],
        "validation": {
          "type": "condition.required",
          "hint": "Выберите один ответ."
        }
      },
      {
        "type": "view.text",
        "content": {
          "type": "data.input",
          "path": "candidate_id"
        }
      }
    ]
  },
  "plugins": [
    {
      "type": "plugin.toloka",
      "layout": {
        "kind": "pager"
      }
    },
    {
      "1": {
        "type": "action.set",
        "data": {
          "type": "data.output",
          "path": "verdict"
        },
        "payload": "accept"
      },
      "2": {
        "type": "action.set",
        "data": {
          "type": "data.output",
          "path": "verdict"
        },
        "payload": "missing"
      },
      "3": {
        "type": "action.set",
        "data": {
          "type": "data.output",
          "path": "verdict"
        },
        "payload": "extra"
      },
      "4": {
        "type": "action.set",
        "data": {
          "type": "data.output",
          "path": "verdict"
        },
        "payload": "boundary"
      },
      "5": {
        "type": "action.set",
        "data": {
          "type": "data.output",
          "path": "verdict"
        },
        "payload": "uncertain"
      },
      "6": {
        "type": "action.set",
        "data": {
          "type": "data.output",
          "path": "verdict"
        },
        "payload": "load_error"
      },
      "type": "plugin.hotkeys"
    }
  ]
}