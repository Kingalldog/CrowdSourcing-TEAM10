{
  "view": {
    "type": "view.list",
    "items": [
      {
        "type": "helper.if",
        "condition": {
          "type": "condition.equals",
          "data": {
            "type": "data.output",
            "path": "photo_not_loaded"
          },
          "to": false
        },
        "then": {
          "type": "field.image-annotation",
          "image": {
            "type": "data.input",
            "path": "image"
          },
          "fullHeight": true,
          "data": {
            "type": "data.output",
            "path": "result"
          },
          "shapes": {
            "rectangle": true
          },
          "validation": {
  "type": "condition.any",
  "conditions": [
    {
      "type": "condition.required",
      "data": {
        "type": "data.output",
        "path": "result"
      }
    },
    {
      "type": "condition.equals",
      "data": {
        "type": "data.output",
        "path": "no_object_on_photo"
      },
      "to": true
    }
  ]
}
        }
      },
      {
        "type": "helper.if",
        "condition": {
          "type": "condition.equals",
          "data": {
            "type": "data.output",
            "path": "photo_not_loaded"
          },
          "to": false
        },
        "then": {
          "type": "field.checkbox",
          "preserveFalse": true,
          "label": "На фото нет объектов",
          "hint": "Отметьте, если выделять нечего.",
          "data": {
            "type": "data.output",
            "path": "no_object_on_photo"
          }
        }
      },
      {
        "type": "field.checkbox",
        "preserveFalse": true,
        "label": "Фотография не загрузилась",
        "hint": "Отметьте, если изображение не открывается.",
        "data": {
          "type": "data.output",
          "path": "photo_not_loaded"
        }
      }
    ]
  },
  "plugins": [
    {
      "type": "plugin.toloka",
      "layout": {
        "kind": "pager"
      }
    },
    {
      "type": "plugin.field.image-annotation.hotkeys",
      "labels": ["1", "2", "3", "4", "5"],
      "modes": {
        "select": "q",
        "rectangle": "e"
      },
      "confirm": "a",
      "cancel": "s"
    }
  ]
}